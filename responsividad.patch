diff --git a/src/styles/_beta-layout.scss b/src/styles/_beta-layout.scss
new file mode 100644
index 0000000..c509c8e
--- /dev/null
+++ b/src/styles/_beta-layout.scss
@@ -0,0 +1,244 @@
+// BetaApp — layout compartido de las pantallas internas (todas menos el login).
+//
+// Móvil primero: las reglas base son las del celular y lo que cambia en
+// pantallas más grandes se declara con min-width. Así ninguna pantalla puede
+// desbordarse en horizontal a 320 px de ancho.
+//
+// Está en estilos globales (no en cada componente) porque lo usan las 12
+// pantallas: un solo lugar que mantener, y los componentes solo declaran lo
+// que es propio de ellos.
+
+$bp-pagina: 600px; // celular grande / tableta pequeña
+$bp-tabla: 720px; // a partir de aquí las tablas vuelven a ser tablas
+
+// ── Página ──────────────────────────────────────────────────────────────────
+.contenido {
+  padding: var(--space-4);
+}
+
+.acciones-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-3) var(--space-5);
+  margin-bottom: var(--space-4);
+}
+
+.tabla {
+  width: 100%;
+}
+
+// Un texto largo sin espacios (un correo, un nombre) se parte en vez de
+// ensanchar la tabla más allá de la pantalla (tabletas en vertical).
+.mat-mdc-table.tabla .mat-mdc-cell {
+  overflow-wrap: anywhere;
+}
+
+.vacio {
+  margin-top: var(--space-4);
+  color: var(--ink-muted);
+}
+
+@media (min-width: $bp-pagina) {
+  .contenido {
+    padding: var(--space-5);
+  }
+}
+
+// En celular los botones de acción ocupan todo el ancho: se alcanzan con el
+// pulgar y no dejan huecos raros al envolverse.
+@media (max-width: $bp-pagina - 0.02px) {
+  .acciones-header > .mat-mdc-button-base {
+    width: 100%;
+  }
+}
+
+// ── Barra superior ──────────────────────────────────────────────────────────
+// Un título largo (p. ej. el nombre de una campaña) se corta en 2 líneas en
+// lugar de empujar los botones fuera de la pantalla. :where() deja la
+// especificidad en cero para que cada pantalla pueda ajustarlo.
+.mat-toolbar > :where(span:not(.spacer)) {
+  display: -webkit-box;
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  line-height: 1.2;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+@media (max-width: $bp-pagina - 0.02px) {
+  .mat-toolbar > :where(span:not(.spacer)) {
+    font-size: 1.125rem;
+  }
+}
+
+// ── Formularios dentro de filas flexibles ───────────────────────────────────
+// Angular Material da a cada campo un ancho mínimo de 180 px; dos campos
+// juntos ya no caben en 360 px. Dejamos que el campo se encoja y que el
+// contenedor decida cuánto mide.
+.mat-mdc-form-field {
+  max-width: 100%;
+}
+
+.mat-mdc-form-field-infix {
+  min-width: 0;
+}
+
+// Un valor largo de un desplegable (p. ej. un nombre de máquina) se corta con
+// "…" en vez de ensanchar el campo; igual que una etiqueta muy larga.
+.mat-mdc-select-trigger,
+.mat-mdc-select-value {
+  min-width: 0;
+}
+
+.mat-mdc-form-field .mdc-floating-label {
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+// ── Diálogos ────────────────────────────────────────────────────────────────
+.mat-mdc-dialog-content {
+  overflow-x: hidden;
+}
+
+// ── Tablas apiladas ─────────────────────────────────────────────────────────
+// Una tabla de 5-7 columnas no cabe en 360 px. En celular cada fila se vuelve
+// una tarjeta con "etiqueta: valor", y desde $bp-tabla vuelve a ser tabla.
+//
+// Uso en la plantilla:
+//   <table mat-table class="tabla tabla-apilada"> (o tabla-apilada--rejilla)
+//   <td mat-cell data-label="Producto">…
+//     data-titulo            → la celda es el título de la tarjeta
+//     data-titulo="Corte"    → título con prefijo ("Corte 3")
+//     data-acciones          → fila de botones al pie de la tarjeta
+//     (sin data-label)       → la celda no se muestra en celular
+@media (max-width: $bp-tabla - 0.02px) {
+  .mat-mdc-table.tabla-apilada {
+    display: block;
+    background: transparent;
+
+    // Los encabezados se ocultan a la vista pero siguen para lectores de pantalla.
+    thead {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+    }
+
+    tbody {
+      display: block;
+    }
+
+    tbody .mat-mdc-row {
+      display: flex;
+      flex-direction: column;
+      height: auto;
+      margin-bottom: var(--space-3);
+      padding: var(--space-2) var(--space-4);
+      border: 1px solid var(--hairline);
+      border-radius: var(--radius-md);
+      background: var(--surface-raised);
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: var(--space-3);
+      min-height: 40px;
+      padding: var(--space-1) 0;
+      border: 0;
+      text-align: right;
+      overflow-wrap: anywhere;
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell:not([data-label]):not([data-acciones]) {
+      display: none;
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell::before {
+      flex: 0 0 38%;
+      max-width: 38%;
+      color: var(--ink-muted);
+      font-size: 0.875rem;
+      font-weight: 700;
+      text-align: left;
+      content: attr(data-label);
+    }
+
+    // Título de la tarjeta
+    tbody .mat-mdc-row > .mat-mdc-cell[data-titulo] {
+      justify-content: flex-start;
+      min-height: 0;
+      padding-bottom: var(--space-2);
+      font-size: 1.125rem;
+      font-weight: 700;
+      text-align: left;
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell[data-titulo]::before {
+      flex: none;
+      max-width: none;
+      margin-right: 0.35em;
+      color: inherit;
+      font-size: inherit;
+      content: attr(data-titulo);
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell[data-titulo='']::before {
+      display: none;
+    }
+
+    // Botones de la fila al pie de la tarjeta
+    tbody .mat-mdc-row > .mat-mdc-cell[data-acciones] {
+      flex-wrap: wrap;
+      justify-content: flex-end;
+      margin-top: var(--space-2);
+      padding-top: var(--space-2);
+      border-top: 1px solid var(--hairline);
+    }
+
+    tbody .mat-mdc-row > .mat-mdc-cell[data-acciones]::before {
+      display: none;
+    }
+  }
+
+  // Variante en rejilla: dos datos por línea, para tarjetas de cifras.
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    column-gap: var(--space-4);
+    row-gap: var(--space-1);
+  }
+
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell {
+    flex-direction: column;
+    align-items: flex-start;
+    justify-content: flex-start;
+    gap: 2px;
+    min-height: 0;
+    text-align: left;
+  }
+
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell::before {
+    flex: none;
+    max-width: none;
+    font-size: 0.8125rem;
+  }
+
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell[data-titulo],
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell[data-acciones],
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell[data-ancho] {
+    grid-column: 1 / -1;
+  }
+
+  .mat-mdc-table.tabla-apilada--rejilla tbody .mat-mdc-row > .mat-mdc-cell[data-titulo] {
+    flex-direction: row;
+    align-items: center;
+  }
+}
